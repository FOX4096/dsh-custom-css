  "cards": [
    {
      "dot": "cyan",
      "title": "为什么是轮询",
      "items": [
        "宿主监听是门铃，跨进程推送需要浏览器半没有的连接",
        "每 1.5s 一次小请求，只在页面可见时发生",
        "比对的是修订号而不是文本：重存同内容不算冲突"
      ]
    },
    {
      "dot": "emerald",
      "title": "干净 vs 有改动",
      "items": [
        "编辑器干净 → 直接采用磁盘那份，不打扰",
        "有未保存内容 → 绝不覆盖，页脚问你要哪一份",
        "采用时会清撤销栈、关规则面板（它们的坐标指向旧文本）"
      ]
    },
    {
      "dot": "amber",
      "title": "两条边界",
      "items": [
        "切回前台只「发现」不「采用」——你可能正读到一半",
        "目录监听起不来也不影响：同步照旧走轮询"
      ]
    }
  ]
