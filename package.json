{
  "name": "dsh-custom-css",
  "version": "0.1.3",
  "description": "DSH Web GUI 扩展：在 设置 → 通用 的「外观」下方提供一行自定义 CSS 编辑器。",
  "license": "MIT",
  "author": "FOX4096",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FOX4096/dsh-custom-css.git"
  },
  "homepage": "https://github.com/FOX4096/dsh-custom-css#readme",
  "bugs": {
    "url": "https://github.com/FOX4096/dsh-custom-css/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "tests/**",
    "assets/icon.svg",
    "cordis.patch.yml",
    "compat.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "custom-css",
    "theme",
    "appearance"
  ],
  "scripts": {
    "test": "node tests/loader-smoke.cjs && node tests/host-api-smoke.mjs",
    "compat": "node tests/compat-matrix.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  }
}
