{
  "name": "dsh-custom-css",
  "version": "0.4.4",
  "description": "DSH Web GUI 扩展：设置 → 通用 里的自定义 CSS 编辑器，以及一个不用写 CSS 的自定义壁纸面板。",
  "icon": "./assets/icon.svg",
  "license": "MIT",
  "author": "FOX4096",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FOX4096/dsh-custom-css.git"
  },
  "homepage": "https://github.com/FOX4096/dsh-custom-css#readme",
  "bugs": {
    "url": "https://github.com/FOX4096/dsh-custom-css/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "tests/**",
    "docs/**/*.md",
    "assets/icon.svg",
    "cordis.patch.yml",
    "compat.json",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "custom-css",
    "theme",
    "appearance"
  ],
  "scripts": {
    "test": "node tests/loader-smoke.cjs && node tests/host-api-smoke.mjs && node tests/probe-strict-smoke.mjs",
    "compat": "node tests/compat-matrix.mjs",
    "compat:check": "node tests/update-compat.mjs",
    "compat:update": "node tests/update-compat.mjs --write",
    "audit": "node shared/sync.mjs --check && node tests/audit-radii.mjs && node tests/audit-fonts.mjs && node tests/audit-accessible-names.mjs && node tests/audit-ui.mjs && node tests/audit-docs.mjs && node tests/audit-skin.mjs",
    "audit:duplication": "node tests/audit-duplication.mjs",
    "dev": "node dev/instance.mjs up",
    "dev:alpha": "node dev/instance.mjs up --alpha",
    "dev:down": "node dev/instance.mjs down",
    "dev:status": "node dev/instance.mjs status",
    "dev:dump": "node dev/instance.mjs dump",
    "ego": "node dev/ego.mjs",
    "probe": "node tests/visual-probe.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  }
}
